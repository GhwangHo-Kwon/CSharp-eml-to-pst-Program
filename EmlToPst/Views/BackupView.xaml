<UserControl x:Class="EmlToPst.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="회사 웹메일 백업" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,14" Foreground="#4E6074" TextWrapping="Wrap"
                       Text="선택한 메일함을 EML로 저장합니다. 같은 계정과 저장 폴더로 다시 시작하면 이어서 백업합니다." />

            <Border Padding="14" Background="White" BorderBrush="#D7DFE7" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" /><ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="IMAP 서버" />
                    <TextBox Grid.Column="1" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="IMAP 서버"
                             Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="포트" />
                    <TextBox Grid.Column="3" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="IMAP 포트"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="로그인 ID" />
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                             IsEnabled="{Binding IsIdle}" AutomationProperties.Name="IMAP 로그인 ID"
                             Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Text="비밀번호" />
                    <PasswordBox x:Name="ImapPassword" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                 IsEnabled="{Binding IsIdle}" Padding="8,5" MinHeight="32"
                                 AutomationProperties.Name="IMAP 비밀번호" PasswordChanged="PasswordChanged" />
                    <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="10,8,0,0"
                            Content="연결 및 메일함 조회" Command="{Binding ConnectCommand}" />
                </Grid>
            </Border>

            <Grid Margin="0,12,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="전체 선택" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" />
                    <Button Content="선택 해제" Command="{Binding SelectNoneCommand}" />
                </StackPanel>
            </Grid>
            <DataGrid ItemsSource="{Binding Mailboxes}" Height="150" AutoGenerateColumns="False"
                      IsEnabled="{Binding IsIdle}" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" BorderBrush="#D7DFE7"
                      AutomationProperties.Name="백업할 메일함 목록" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="선택" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="메일함 백업 선택" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="서버 메일함 경로" Binding="{Binding FullName}" Width="*" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="저장 폴더" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Destination, Mode=OneWay}" IsReadOnly="True"
                         AutomationProperties.Name="EML 백업 저장 폴더" ToolTip="{Binding Destination}" />
                <Button Grid.Column="2" Content="폴더 선택" Command="{Binding SelectDestinationCommand}" Margin="8,0,0,0" />
            </Grid>
            <WrapPanel Margin="0,12,0,8" HorizontalAlignment="Right">
                <Button Content="백업 시작 / 이어서 백업" Command="{Binding StartCommand}" Margin="0,0,8,4"
                        Background="#DCEBFF" BorderBrush="#86ADE2" FontWeight="SemiBold" />
                <Button Content="중단" Command="{Binding CancelCommand}" Margin="0,0,0,4" />
            </WrapPanel>
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Current}" Foreground="#4E6074" Margin="0,4,0,6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Current}" />
            <ProgressBar Height="8" Maximum="{Binding Total, Mode=OneWay}" Value="{Binding Processed, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" AutomationProperties.Name="웹메일 백업 진행률" />
            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="#79510C" Margin="0,8,0,8" />

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox IsReadOnly="True" Text="{Binding MessageRoot, Mode=OneWay}" ToolTip="{Binding MessageRoot}"
                         AutomationProperties.Name="백업된 EML 폴더" />
                <Button Grid.Column="1" Content="PST 변환에 사용" Command="{Binding UseForPstCommand}" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="실패하거나 서버에서 사라진 메일 / 메일함" FontWeight="SemiBold" Margin="0,12,0,5" />
            <DataGrid ItemsSource="{Binding Failures}" Height="100" IsReadOnly="True" CanUserAddRows="False"
                      AutoGenerateColumns="False" HeadersVisibility="Column" BorderBrush="#D7DFE7"
                      ClipboardCopyMode="IncludeHeader" AutomationProperties.Name="IMAP 백업 오류 목록">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="메일함" Binding="{Binding Mailbox}" Width="2*" />
                    <DataGridTextColumn Header="메일 ID" Binding="{Binding Uid}" Width="85" />
                    <DataGridTextColumn Header="오류 내용" Binding="{Binding Reason}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
