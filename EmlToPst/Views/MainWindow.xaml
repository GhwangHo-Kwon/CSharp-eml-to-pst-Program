<Window x:Class="EmlToPst.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EmlToPst.Views"
        Title="회사 웹메일 백업 · EML → PST" Width="1040" Height="920" MinWidth="860" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA"
        FontFamily="Segoe UI, Malgun Gothic" Foreground="#17293D">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" /><Setter Property="MinHeight" Value="32" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5" /><Setter Property="BorderBrush" Value="#C7D2DE" />
            <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="MinHeight" Value="32" />
        </Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="18,9" /></Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TabControl SelectedIndex="{Binding SelectedTab}" Background="#F5F7FA" BorderBrush="#D7DFE7">
            <TabItem Header="웹메일 백업">
                <views:BackupView x:Name="BackupPage" DataContext="{Binding Backup}" />
            </TabItem>
            <TabItem Header="EML → PST 변환">
                <views:PstImportView DataContext="{Binding Pst}" />
            </TabItem>
        </TabControl>
        <Border Grid.Row="1" Padding="12" Margin="0,12,0,0" Background="White" BorderBrush="#D7DFE7" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="{Binding SessionStatus}" FontWeight="SemiBold" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding LogPath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding LogPath}"
                             AutomationProperties.Name="프로그램 실행 로그 파일" />
                    <Button Grid.Column="1" Content="실행 로그 열기" Command="{Binding OpenLogCommand}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding LogProblem}" TextWrapping="Wrap" Foreground="#A12D27" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
